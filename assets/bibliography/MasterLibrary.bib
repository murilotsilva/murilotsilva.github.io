@Article{Hasselmann1963a,
  author    = {Hasselmann, K.},
  journal   = {J. Fluid Mech.},
  title     = {On the non-linear energy transfer in a gravity wave spectrum. {Part} 2. {Conservation} theorems; wave-particle analogy; irrevesibility},
  year      = {1963},
  issn      = {0022-1120},
  month     = {feb},
  number    = {02},
  pages     = {273},
  volume    = {15},
  abstract  = {{\textless}div class="abstract" data-abstract-type="normal"{\textgreater}{\textless}p{\textgreater}From the conditions of energy and momentum conservation it is shown that all four interaction coefficients of the elementary quadruple interactions discussed in Part I of this paper are equal. A further conservative quantity is then found which can be interpreted as the number density of the gravity-wave ensemble representing the random sea surface. The well-known analogy between a random linear wave field and a mass particle ensemble is found to hold also in the case of weak non-linear interactions in the wave field. The interaction conditions for energy transfer between waves to correspond to the equations of energy and momentum conservation for a particle collision, the final equation for the rate of change of the wave spectrum corresponding to Boltzmann's equation for the rate of change of the number density of an ensemble of colliding mass particles. The stationary wave spectrum corresponding to the Maxwell distribution for a mass particle ensemble is found to be degenerate. The question of the irreversibility of the transfer process for gravity waves is discussed but not completely resolved.{\textless}/p{\textgreater}{\textless}/div{\textgreater}},
  doi       = {10.1017/S0022112063000239},
  file      = {:Hasselmann1963a - On the Non Linear Energy Transfer in a Gravity Wave Spectrum Part 2. Conservation Theorems\; Wave Particle Analogy\; Irrevesibility.pdf:pdf},
  fjournal  = {Journal of Fluid Mechanics},
  groups    = {PhD},
  publisher = {Cambridge University Press},
}

@Article{Hasselmann1963,
  author    = {Hasselmann, K.},
  journal   = {J. Fluid Mech.},
  title     = {On the non-linear energy transfer in a gravity-wave spectrum. {Part} 3. {Evaluation} of the energy flux and swell-sea interaction for a {Neumann} spectrum},
  year      = {1963},
  issn      = {0022-1120},
  month     = {mar},
  number    = {3},
  pages     = {385--398},
  volume    = {15},
  abstract  = {{\textless}p{\textgreater}The energy transfer due to non-linear interactions between the components of a gravity-wave spectrum discussed in Parts 1 and 2 of this paper is evaluated for a fully and partially developed Neumann spectrum with various spreading factors. The characteristic time scales of the energy transfer are found to be typically of the order of a few hours. In all cases the high frequencies and the low-frequency peak are found to gain energy from an intermediate range of frequencies. The transfer of energy to very low frequencies and to waves travelling at large angles to the main propagation direction of the spectrum is negligible. Computations are presented also for the rate of decay of swell interacting with local wind-generated seas (represented by a Neumann spectrum). An appreciable decay is found only for swell frequencies in the same range as those of the local sea.{\textless}/p{\textgreater}},
  doi       = {10.1017/S002211206300032X},
  file      = {:Hasselmann1963 - On the Non Linear Energy Transfer in a Gravity Wave Spectrum. Part 3. Evaluation of the Energy Flux and Swell Sea Interaction for a Neumann Spectrum.pdf:pdf},
  fjournal  = {Journal of Fluid Mechanics},
  groups    = {PhD},
  publisher = {Cambridge University Press},
}

@Article{Weber1977,
  author   = {Weber, B. L. and Barrick, Donald E},
  journal  = {J. Phys. Oceanogr.},
  title    = {On the nonlinear theory for gravity waves on the ocean's surface. {Part} {I}: derivations},
  year     = {1977},
  issn     = {0022-3670},
  month    = {jan},
  number   = {1},
  pages    = {3--10},
  volume   = {7},
  abstract = {Abstract A general hydrodynamic solution is derived for arbitrary gravity-wave fields on the ocean surface by extending Stokes' (1847) original perturbational analysis. The solution to the nonlinear equations of motion is made possible by assuming that the surface height is periodic in both space and time and thus can be described by a Fourier series. The assumption of periodicity does not limit the generality of the result because the series can be made to approach an integral representation by taking arbitrarily large fundamental periods with respect to periods of the dominant ocean waves actually present on the surface. The observation areas and times over which this analysis applies are assumed small, however, compared to the periods required for energy exchange processes; hence an “energy balance” (or steady-state) condition is assumed to exist within the observed space-time intervals. This in turn implies the condition of statistical stationarity of the Fourier height coefficients when one generaliz...},
  doi      = {10.1175/1520-0485(1977)007<0003:OTNTFG>2.0.CO;2},
  file     = {:Weber1977 - On the Nonlinear Theory for Gravity Waves on the Ocean's Surface. Part I_ Derivations.pdf:pdf},
  fjournal = {Journal of Physical Oceanography},
  groups   = {PhD},
}

@Article{Arsenin1976,
  author   = {Arsenin, V. Ya.},
  journal  = {Russ. Math. Surv.},
  title    = {On ill-posed problems},
  year     = {1976},
  number   = {6},
  pages    = {93--107},
  volume   = {31},
  abstract = {1. The rapidly growing use of computers requires the development of new computational algorithms for the solution of wide classes of problems. Among problems of a mathematical character we can distinguish two large classes: a) well-posed problems, and b) ill-posed problems, according to the terminology introduced by Hadamard. Until recently only well-posed problems were studied, but there is a wide range of applied problems, as well as classical problems of mathematical analysis and algebra that are ill-posed, and the necessity of working out methods for the solution of such problems has become obvious. Now, what should we mean by a "solution" of such problems? What kind of conditions do we have to impose on algorithms used to find "solutions"? Classical concepts do not reflect the peculiarities of problems that refer to ill-posed problems. A new approach to the solution of ill-posed problems was worked out by Tikhonov in 1963, who obtained basic results in this direction. His approach has been developed in papers of many authors, and by the present time a new branch of mathematics has been formed, on the basis of Tikhonov's ideas and results. Within its framework many problems of great practical value have been solved. 2. Solving any quantitative problem usually consists in finding a "solution" $\zeta$ corresponding to given "initial data" u, so that $\zeta$ = R(u). We are going to assume that $\zeta$ and u are elements of metric spaces F and U, with metrics p F (zi, z 2) and p u (z l , z 2), respectively.. Suppose that a notion of "solution" has been defined and that to every element u € U there corresponds a unique solution $\zeta$ = R(u) in F. The problem of determining a solution $\zeta$ = R(u) in F for given initial data u €$\Xi$ U is called stable on the spaces (F, U) if one can find, for every $\epsilon$ {\textgreater} 0, a $\delta$ ($\epsilon$) {\textgreater} 0 such that from 8 u (u l , u 2) {\textless} $\delta$($\epsilon$) it follows that 8 F (z l , z 2) {\textless} $\epsilon$, with z x -R(ui), z 2 = R(u 2). The problem of determining a solution $\zeta$ in F for given "initial data" u in U is said to be well-posed on the pair of spaces (F, U) if: 93 94 V{\textperiodcentered} y«{\textperiodcentered} Arsenin 1) for every u Ε U there exists a solution $\zeta$ in F; 2) the solution is uniquely determined; 3) the solution is stable on the spaces (F, U). Problems not satisfying these conditions are said to be ill-posed. Condition 3) is connected with the physically determinate character of the problem, as well as with the possibility to use numerical methods in order to find a solution when the initial data are only approximately known. 3. For a long time the view was predominant in the mathematical literature that every mathematical problem with physical or technical connections has to be well-posed. As a matter of fact, what kind of physical interpretation can be given to the solution of a problem if an arbitrarily small perturbation of the data can give rise to a large change in the solution? This argument put in doubt the expediency of studying ill-posed problems. However, this point of view, which is natural in applications to certain phenomena developing with time, cannot be extended to all kinds of situations. In fact, the following are examples of ill-posed problems: the solution of integral equations of the first kind; the differentiation of approximately known functions; the numerical computation of Fourier series when the coefficients are approximately known in l 2 ; Cauchy's problem for the Laplace equation (in the two-dimensional case); problems of analytic continuation of functions from part of a domain to the whole domain; inverse gravimetric problems; the solution of a system of linear algebraic equations (when the determinant of the system vanishes or the system is ill-conditioned); minimization of functionals when the convergence to the infimum of the values of the functional to be minimized does not imply the convergence of a minimizing sequence; certain problems of linear programming and optimal control; the design of optimal systems of construction (synthesis of antennae and other physical systems). The most diverse physical and technical problems belong to the categories listed above. A large class of ill-posed problems originating in physics, technology, and other branches of science, are the so-called inverse problems where one wants to find the solution of an equation Az = u with respect to z. A large part of the problems listed above are of this type. 4. Suppose that the object (or phenomenon) under discussion is characterized by an element z T (a function or a vector) belonging to a set of admissible solutions F in a metric space F. Often z T is inaccessible for direct measurement and is measured in terms of some action u T = Az T (with u T € AF, where AF is the image of F under its transformation by means of the operator{\^{}}). Obviously, the equation (1) Az = u has a solution in F only for those elements u that belong to AF. Since u is obtained through measurements, it is known to us only approximately.},
  doi      = {10.1070/rm1976v031n06abeh001579},
  file     = {:Arsenin1976 - On Ill Posed Problems.pdf:pdf},
  fjournal = {Russian Mathematical Surveys},
  groups   = {Masters},
}

