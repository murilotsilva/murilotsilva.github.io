@Article{Hasselmann1962,
  author    = {Hasselmann, K.},
  journal   = {J. Fluid Mech.},
  title     = {On the non-linear energy transfer in a gravity-wave spectrum {Part} 1. {General} theory},
  year      = {1962},
  issn      = {0022-1120},
  month     = {apr},
  number    = {4},
  pages     = {481--500},
  volume    = {12},
  abstract  = {{\textless}div class="abstract" data-abstract-type="normal"{\textgreater}{\textless}p{\textgreater}The energy flux in a finite-depth gravity-wave spectrum resulting from weak non-linear couplings between the spectral components is evaluated by means of a perturbation method. The fifth-order analysis yields a fourth-order effect comparable in magnitude to the generating and dissipating processes in wind-generated seas. The energy flux favours equidistribution of energy and vanishes in the limiting case of a white, isotropic spectrum. The influence on the equilibrium structure of fully developed wave spectra and on other phenomena in random seas is discussed briefly.{\textless}/p{\textgreater}{\textless}/div{\textgreater}},
  doi       = {10.1017/S0022112062000373},
