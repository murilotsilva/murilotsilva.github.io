}

@Article{Phillips1957,
  author    = {Phillips, O. M.},
  journal   = {J. Fluid Mech.},
  title     = {On the generation of waves by turbulent wind},
  year      = {1957},
  issn      = {0022-1120},
  month     = {jul},
  number    = {05},
  pages     = {417},
  volume    = {2},
  abstract  = {A theory is initiated for the generation of waves upon a water surface, originally at rest, by a random distribution of normal pressure associated with the onset of a turbulent wind. Corrlations between air and water motions are neglected and the water is assumed to be inviscid, so that the motion of the water, starting from rest, is irrotational. It is found that waves develop most rapidly by means of a resonance mechanism which occurs when a component of the surface pressure distribution moves at the same speed as the free surface wave with the same wave-number. The development of the waves is conveniently considered in two stages, in which the time elapsed is respectively less or greater than the time of development of the pressure fluctuations. An expression is given for the wave spectrum in the initial stage of development ({\S} 3.2), and it is shown that the most prominent waves are ripples of wavelength $\lambda$cr = 1{\textperiodcentered}7 cm, corresponding to the minimum phase velocity c = (4gT/$\rho$)1/4 and moving in directions cos-1(c/Uc) to that of the mean wind, where Uc is the ‘convection velocity' of the surface pressure fluctuations of length scale $\lambda$cr or approximately the mean wind speed at a height $\lambda$cr above the surface. Observations by Roll (1951) have shown the existence under appropriate conditions, of waves qualitatively similar to those predicted by the theory. Most of the growth of gravity waves occurs in the second, or principal stage of development, which continues until the waves grow so high that non-linear effects become important. An expression for the wave spectrum is derived ({\S} 4.1), from which follows the result {\$}\backslashoverline {\{}\backslashxi {\^{}}2{\}} \backslashsim \backslashfrac {\{}\backslashoverline{\{}p{\^{}}2{\}}t{\}} {\{}2 \backslashsurd 2\backslashrho {\^{}}2 U_c g{\}},{\$} where {\$}\backslashoverline {\{}\backslashxi {\^{}}2{\}}{\$} is the mean square surface displacement, {\$}\backslashoverline {\{}p {\^{}}2{\}}{\$} the mean square turbulent pressure on the water surface, t the elapsed time, Uc the convection speed of the surface pressure fluctuations, and $\rho$ the water density. This prediction is consistent with published oceanographic measurements ({\S} 4.3). It is suggested that this resonance mechanism is more effective than those suggested by Jeffreys (1924, 1925) and Eckart (1953), and may provide the principal means whereby energy is transferred from the wind to the waves.},
  doi       = {10.1017/S0022112057000233},
  file      = {:Phillips1957 - On the Generation of Waves by Turbulent Wind.pdf:pdf},
  fjournal  = {Journal of Fluid Mechanics},
  groups    = {Masters},
  publisher = {Cambridge University Press},
}

